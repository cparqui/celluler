{
  "name": "celluler",
  "version": "0.1.0",
  "description": "A distributed cell-based architecture for P2P microservices",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cell": "src/cli.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "start:dev": "node src/cli.js start -c config/local.config.yaml",
    "build:docker": "docker compose build",
    "start:docker": "docker compose up -d",
    "logs:docker": "docker compose logs -f",
    "stop:docker": "docker compose down",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:html": "jest --coverage --coverageReporters=html",
    "test:coverage:watch": "jest --coverage --watch",
    "test:coverage:threshold": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "docs:serve": "cd docs && bundle exec jekyll serve",
    "docs:build": "cd docs && bundle exec jekyll build",
    "schema:build": "node scripts/build-schema.js"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "bunyan": "^1.8.15",
    "commander": "^15.0.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.16.1",
    "hypercore": "^11.39.6",
    "hyperschema": "^1.26.2",
    "hyperswarm": "^4.17.2",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "moleculer": "^0.15.2",
    "moleculer-web": "^0.11.0",
    "nats": "^2.29.3",
    "random-access-memory": "^6.2.1",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "hyperdht": "^6.35.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  }
}
