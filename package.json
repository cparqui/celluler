{
  "name": "celluler",
  "version": "0.1.0",
  "description": "A distributed cell-based architecture for P2P microservices",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cell": "src/cli.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "start:dev": "node src/cli.js start -c config/local.config.yaml",
    "build:docker": "docker compose build",
    "start:docker": "docker compose up -d",
    "logs:docker": "docker compose logs -f",
    "stop:docker": "docker compose down",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "test:coverage:html": "npm test -- --coverage --coverageReporters=html",
    "test:coverage:watch": "npm test -- --coverage --watch",
    "test:coverage:threshold": "npm test -- --coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "docs:serve": "cd docs && bundle exec jekyll serve",
    "docs:build": "cd docs && bundle exec jekyll build",
    "schema:build": "node scripts/build-schema.js"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "commander": "^15.0.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.16.1",
    "hypercore": "^11.39.6",
    "hyperschema": "^1.26.2",
    "hyperswarm": "^4.17.2",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "moleculer": "^0.15.2",
    "moleculer-web": "^0.11.0",
    "nats": "^2.29.3",
    "pino": "^10.4.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "hyperdht": "^6.35.0",
    "jest": "^30.5.2"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
